# Copia a .env.local en tu PC (gitignore). No subir a InfinityFree.
# Sobrescribe claves del .env solo en local (mail, APP_DEBUG, etc.).
#
# Docker: opcional; compose ya fuerza DB_* al MySQL del contenedor `db`.
# Si LOCAL_DB_PASSWORD está aquí, añádela también en .env para que Compose la sustituya,
# o deja el default cambiar_en_local (ver .env.example).

LOCAL_DB_PASSWORD=cambiar_en_local

# Alternativa sin Docker (php -S / Apache local):
# DB_HOST=127.0.0.1
# DB_NAME=liga_padel
# DB_USER=admin_padel
# DB_PASSWORD=cambiar_en_local
