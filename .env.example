# Copiar a .env (no commitear)

APP_ENV=local
APP_DEBUG=true

# Registro / reenvío PIN: límite por IP (registro_attempts). false en dev, true en producción.
REGISTRATION_RATE_LIMIT=false

# Detrás de reverse proxy (nginx, Cloudflare): usar IP real en rate limits de login/recuperación.
TRUSTED_PROXY=false

# Preproducción/producción: redirigir HTTP→HTTPS (false solo si pruebas sin TLS en LAN).
FORCE_HTTPS=true

# Cron HTTP (hosting sin CLI): secreto largo; ver .env.staging.example
# CRON_SECRET=

DB_HOST=db
DB_PORT=3306
DB_NAME=liga_padel
DB_USER=admin_padel
DB_PASSWORD=cambiar_en_local
DB_CHARSET=utf8mb4

MYSQL_ROOT_PASSWORD=cambiar_root_en_local

# Registro: PIN al correo real (como producción). Solo tests: SKIP_EMAIL_VERIFICATION=true
# Modo simulado únicamente si lo pones explícito: MAIL_DRIVER=fake
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=correo@tudominio.com
MAIL_FROM_NAME=Volea de Revés

# Gmail (app password): puerto 465 + ssl. Otros proveedores suelen usar 587 + tls.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_16_caracteres
MAIL_ENCRYPTION=ssl

# Alternativa: copia config/mail.local.example.php → config/mail.local.php (datos del servidor tenis)
# O MAIL_DSN=smtps://user:pass@smtp.ejemplo.com:465
