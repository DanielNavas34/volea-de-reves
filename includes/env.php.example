<?php
/**
 * Plantilla de carga de .env (sí va a GitHub).
 * Copia a includes/env.php en tu PC o en el hosting (includes/env.php no se sube al repo).
 * Si falta env.php, la app usa este archivo automáticamente vía load_env.php.
 */

/** @var list<string> */
const ENV_DOCKER_PROTECTED_PREFIXES = ['DB_'];

function envIsProtectedFromFileOverride(string $name): bool
{
    foreach (ENV_DOCKER_PROTECTED_PREFIXES as $prefix) {
        if (str_starts_with($name, $prefix)) {
            return true;
        }
    }

    return false;
}

function envAlreadySet(string $name): bool
{
    if (getenv($name) !== false) {
        return true;
    }
    if (isset($_ENV[$name]) && $_ENV[$name] !== '') {
        return true;
    }
    if (isset($_SERVER[$name]) && $_SERVER[$name] !== '') {
        return true;
    }

    return false;
}

function loadEnvFile(string $path): void
{
    if (!is_readable($path)) {
        return;
    }

    $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if ($lines === false) {
        return;
    }

    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#')) {
            continue;
        }
        if (!str_contains($line, '=')) {
            continue;
        }
        [$name, $value] = explode('=', $line, 2);
        $name = trim($name);
        $value = trim($value);
        if ($name === '') {
            continue;
        }
        if (
            (str_starts_with($value, '"') && str_ends_with($value, '"')) ||
            (str_starts_with($value, "'") && str_ends_with($value, "'"))
        ) {
            $value = substr($value, 1, -1);
        }
        // Docker Compose inyecta DB_* para local; no dejar que el .env de producción las pise.
        if (envIsProtectedFromFileOverride($name) && envAlreadySet($name)) {
            continue;
        }
        putenv("$name=$value");
        $_ENV[$name] = $value;
        $_SERVER[$name] = $value;
    }
}

$projectRoot = dirname(__DIR__);
loadEnvFile($projectRoot . DIRECTORY_SEPARATOR . '.env');
loadEnvFile($projectRoot . DIRECTORY_SEPARATOR . '.env.local');

function env(string $key, ?string $default = null): ?string
{
    $value = getenv($key);
    if ($value !== false && $value !== '') {
        return $value;
    }
    if (isset($_ENV[$key]) && $_ENV[$key] !== '') {
        return (string) $_ENV[$key];
    }
    if (isset($_SERVER[$key]) && $_SERVER[$key] !== '') {
        return (string) $_SERVER[$key];
    }

    return $default;
}
