# Copiar a .env en el servidor de PREPRODUCCIÓN (no commitear .env)

APP_ENV=staging
APP_DEBUG=false
FORCE_HTTPS=true

REGISTRATION_RATE_LIMIT=true
# true solo si hay un proxy delante (nginx, Cloudflare) que añade X-Forwarded-For.
TRUSTED_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=liga_padel
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Secreto largo aleatorio para cron HTTP (cron-job.org, etc.)
CRON_SECRET=genera_un_secreto_largo_aleatorio

# Nunca fake en preproducción
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Volea de Revés
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

SKIP_EMAIL_VERIFICATION=false
